<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- From Android 12 the launch screen is drawn by the system and ignores
         windowBackground, so without this the app opens on a white flash
         before a dark UI. -->
    <style name="Theme.Clearlane" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0E1116</item>
        <item name="android:navigationBarColor">#0E1116</item>
        <item name="android:windowBackground">#0E1116</item>
        <item name="android:windowSplashScreenBackground">#0E1116</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
